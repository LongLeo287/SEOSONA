# SEOSONA Website local environment template
#
# Keep this file web-only. Do not store OS, agent, or design-system runtime
# configuration in this repository.

# Canonical public origin. Keep the production value for the default build;
# override only for an approved staging origin or an explicitly local preview.
NEXT_PUBLIC_SITE_URL=https://seosona.com

# HTTPS endpoint that persists or forwards contact and Academy leads.
# Leave unset locally to keep lead forms fail-closed instead of reporting fake success.
SEOSONA_LEAD_WEBHOOK_URL=
SEOSONA_LEAD_WEBHOOK_TOKEN=
